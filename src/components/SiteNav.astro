---
import { Image } from 'astro:assets';
import { Icon } from "astro-icon/components";
import siteLogo from "@images/mg_site_logo_2024.png";
---

<header class="flex items-center px-8 py-2 border-b-2 border-brand-gray text-content-primary">
  <div class="w-[1280px] m-auto flex">
    <nav class="main-nav flex flex-auto justify-center md:justify-normal">
      <span class="logo w-16">
        <a href="/">
          <Image src={siteLogo} alt="website main logo" width="64" height="60" />
        </a>
      </span>
      <ul class="hidden md:flex md:items-center md:justify-between md:ml-12">
        <li class="px-5 text-lg font-normal">
          <a href="/about" class="font-medium pb-0.5 hover:border-b-2 border-brand-primary">About Me</a>
        </li>
        <li class="px-5 text-lg font-normal">
          <a href="/my-work" class="font-medium pb-0.5 hover:border-b-2 border-brand-primary">My Work</a>
        </li>
        <li class="px-5 text-lg font-normal">
          <a href="/contact" class="font-medium pb-0.5 hover:border-b-2 border-brand-primary">Contact</a>
        </li>
      </ul>
    </nav>

    <div class="hidden md:flex md:items-center">
      <span class="pl-5 text-lg font-normal">Find me on:</span>
      <nav class="social-links">
        <ul class="flex items-center">
          <li class="px-1 border-r-2 border-black">
            <a href="https://www.linkedin.com/in/matthewgerton" class="hover:text-brand-primary">
              <Icon name="fa6-brands:linkedin" class="text-3xl mx-2" />
            </a>
          </li>
          <li class="px-1">
            <a href="https://github.com/mgerton" class="hover:text-brand-primary">
              <Icon name="fa6-brands:github" class="text-3xl mx-2" />
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>