--- 
interface Props {
	title: string;
  metaDescription: string;
}

const { metaDescription, title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Matt Gerton | {title}</title>
	</head>
	<body class="box-border h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary">
		<div class="grid grid-col-1 grid-rows-[auto_1fr_auto]">
			<slot />
		</div>
	</body>
</html>

