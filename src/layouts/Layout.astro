--- 
import SiteNav from "@components/SiteNav.astro";

interface Props {
	title: string;
  metaDescription: string;
}

const { metaDescription, title } = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Matt Gerton</title>
	</head>
	<body class="box-border h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary">
		<div class="grid grid-col-1 grid-rows-[auto_1fr_auto]">
			<SiteNav />

			<slot />

			<footer class="flex items-center px-8 py-2 border-t-2 text-lg font-normal">
				<div class="w-[1280px] m-auto flex">
					&copy; {currentYear} Matt Gerton
				</div>
			</footer>
		</div>
	</body>
</html>

