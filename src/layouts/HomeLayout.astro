--- 
import SiteNav from "@components/SiteNav.astro";
import SiteFooter from "@components/SiteFooter.astro";

interface Props {
	title: string;
  metaDescription: string;
}

const { metaDescription, title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<!-- TODO: enable pinch to zoom? -->
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Matt Gerton</title>
	</head>
  <body class="box-border h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary">
    <div class="w-full h-full grid grid-cols-1 grid-rows-[auto_1fr_auto]">
      <SiteNav />
    
      <slot />
    
      <SiteFooter />
    </div>
  </body>
</html>
