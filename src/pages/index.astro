---
import Layout from "@layouts/Layout.astro";
import { Icon } from 'astro-icon/components'

import siteLogo from "@images/mg_site_logo_2024.png?url";
import mattHeadshot from "@images/matt_headshot_no_bg.png?url";
---

<Layout title="Home" metaDescription="Matt Gerton's homepage">
	<header class="flex items-center px-8 py-7">
		<nav class="main-nav flex flex-auto">
			<span class="logo w-16"><img src={siteLogo} alt="website main logo" /></span>
			<ul class="flex items-center justify-between ml-16">
				<li class="px-5 text-lg font-normal">About</li>
				<li class="px-5 text-lg font-normal">My Work</li>
				<li class="px-5 text-lg font-normal">Blog</li>
				<li class="px-5 text-lg font-normal font-">Contact</li>
			</ul>
		</nav>
		<div class="flex items-center">
			<span class="pl-5 text-lg font-normal">Find me on:</span>
			<nav class="social-links">
				<ul class="flex items-center">
					<li class="px-1 border-r-2 border-black"><Icon name="fa6-brands:linkedin" class="text-3xl mx-2" /></li>
					<li class="px-1"><Icon name="fa6-brands:github" class="text-3xl mx-2" /></li>
				</ul>
			</nav>
		</div>
	</header>

	<main class="flex items-center justify-evenly pt-14 pr-28 gap-48">
		<section class="flex flex-[1_0_0%] flex-col max-w-xl mb-auto mt-44">
			<header>
				<h1 class="font-bold text-7xl pb-9">Matt Gerton</h1>
				<h2 class="text-[1.75rem] leading-[2.125rem] pb-16">Software professional and technology enthusiast based in Southern California</h2>
			</header>
			<a class="inline-flex justify-center rounded-lg text-md text-white font-medium py-2.5 px-4 bg-blue-400 w-52" href="/about">More about Matt</a>
		</section>
		<section>
			<img src={mattHeadshot} alt="matt headshot" class="w-3xl" />
		</section>
	</main>
</Layout>
