---
import HomeLayout from "@layouts/HomeLayout.astro";
import Button from "@components/Button.astro";

import { Image } from "astro:assets";
import heroImage from "@images/matt_hero_img.png";
---

<HomeLayout title="Home" metaDescription="Matt Gerton's homepage">
  <section
    class="flex flex-col items-center text-center order-2 pb-32 md:order-1 md:pb-0"
  >
    <header class="flex flex-col items-center text-center">
      <h1 class="font-bold text-5xl md:text-7xl text-content-primary pb-9">
        Matt Gerton
      </h1>
      <h2
        class="text-content-primary text-lg w-72 md:w-[28rem] md:text-[1.75rem] md:leading-[2.125rem] pb-16"
      >
        Experienced Software Engineer and Technology Enthusiast
      </h2>
    </header>
    <div
      class="inline-flex flex-col md:flex-row items-center justify-center gap-6"
    >
      <Button href="/about" label="About Me" />
      <Button href="/my-work" label="My Work" />
    </div>
  </section>
  <section
    class="flex items-center justify-self-center md:justify-self-auto justify-center w-3/5 md:w-full order-1 md:order-2"
  >
    <Image
      src={heroImage}
      alt="Matt Gerton headshot"
      class="w-xl"
      loading="eager"
    />
  </section>
</HomeLayout>
